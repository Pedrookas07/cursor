# ===========================================
# CONFIGURAÇÕES DO SISTEMA REBUSS
# ===========================================
# Este arquivo contém todas as variáveis de ambiente necessárias
# Copie este arquivo para .env e configure os valores

# ===========================================
# CONFIGURAÇÕES DE LOG
# ===========================================
LOG_FILE=logs/app.log
LOG_LEVEL=INFO

# ===========================================
# CONFIGURAÇÕES DO SLACK
# ===========================================
# Token do bot (Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# ID do canal onde o bot recebe logs
SLACK_CHANNEL_ID=C1234567890

# Nome do canal (para exibição)
SLACK_CHANNEL_NAME=#rebuss-logs

# ID do bot (opcional, para filtrar apenas mensagens do bot)
BOT_USER_ID=U1234567890

# Webhook URL para envio de logs (opcional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Canal para envio de logs via webhook
SLACK_CHANNEL=#logs

# Configurações de busca
DEFAULT_HOURS_BACK=24
MAX_MESSAGES_PER_REQUEST=100

# Configurações de exportação
EXPORT_DIRECTORY=exports

# Configurações de envio de logs
SEND_WARNINGS_TO_SLACK=true
SEND_ERRORS_TO_SLACK=true

# ===========================================
# CONFIGURAÇÕES DO CLOUDFLARE
# ===========================================
# URL do Worker do Cloudflare
CLOUDFLARE_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Token da API do Cloudflare
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# ID da conta do Cloudflare
CLOUDFLARE_ACCOUNT_ID=your-account-id

# ID do namespace KV do Cloudflare
CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id

# Timeout para requisições (em segundos)
CLOUDFLARE_TIMEOUT_SECONDS=15

# ===========================================
# CONFIGURAÇÕES DO WRANGLER
# ===========================================
# Nome do projeto
WRANGLER_PROJECT_NAME=chanfana-openapi

# Data de compatibilidade
WRANGLER_COMPATIBILITY_DATE=2024-09-27

# Ambiente
ENVIRONMENT=production

# ===========================================
# CONFIGURAÇÕES GERAIS
# ===========================================
# Diretório de logs
LOGS_DIRECTORY=logs

# Diretório de exports
EXPORTS_DIRECTORY=exports

# Timeout padrão para operações
DEFAULT_TIMEOUT=30

# Número máximo de tentativas
MAX_RETRIES=3

# Intervalo entre tentativas (em segundos)
RETRY_INTERVAL=5
